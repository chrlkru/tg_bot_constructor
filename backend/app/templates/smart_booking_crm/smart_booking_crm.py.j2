from aiogram.types import (
    BotCommand,
    BotCommandScopeDefault,
    BotCommandScopeAllPrivateChats,
    BotCommandScopeAllGroupChats,
    BotCommandScopeChat,
)
# --- Команды бота (вызывает run.py) ------------------------------------------
async def setup_bot_commands(bot: Bot):
    """Регистрирует команды для обычных пользователей и для админов."""
    logging.info("▶︎ Entered setup_bot_commands()")


    # 1) Общие (публичные) команды для всех —
    user_cmds = [
        BotCommand(command="start",  description="начать работу / записаться"),
        BotCommand(command="cancel", description="отменить действие"),
        BotCommand(command="help",   description="инструкция"),
    ]
    # Применяем везде по умолчанию
    await bot.set_my_commands(user_cmds, scope=BotCommandScopeDefault(), language_code="ru")
    await bot.set_my_commands(user_cmds, scope=BotCommandScopeAllPrivateChats(), language_code="ru")
    await bot.set_my_commands(user_cmds, scope=BotCommandScopeAllGroupChats(), language_code="ru")

    # 2) Админские команды — только в конкретном чате
    admin_cmds = [
        BotCommand(command="add_service",     description="➕ Добавить услугу"),
        BotCommand(command="del_service",     description="➖ Удалить услугу"),
        BotCommand(command="add_slot",        description="➕ Добавить свободное окно"),
        BotCommand(command="remove_slot",     description="➖ Удалить окно"),
        BotCommand(command="schedule",        description="📅 Посмотреть расписание"),
        BotCommand(command="panic_now",       description="⛔ Срочно закрыть всё"),
        BotCommand(command="panic_later",     description="⏳ Запланировать закрытие"),
        BotCommand(command="export_clients",  description="📁 Экспорт клиентов"),
        BotCommand(command="export_orders",   description="📁 Экспорт записей"),
    ]
    await bot.set_my_commands(
        user_cmds + admin_cmds,
        scope=BotCommandScopeChat(chat_id=ADMIN_CHAT),
        language_code="ru"
    )
    logging.info("✅ Exiting setup_bot_commands()")
