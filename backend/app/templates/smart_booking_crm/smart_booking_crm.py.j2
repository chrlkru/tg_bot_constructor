# Handler for user sending phone (could be contact or text)
@router.message(ClientBooking.entering_phone)
async def user_enter_phone(message: Message, state: FSMContext):
    phone = None
    if message.contact:
        # User shared contact
        phone = message.contact.phone_number
    else:
        # User typed phone
        phone = message.text.strip()
    # Basic validation for phone
    digits = [d for d in phone if d.isdigit()]
    if len(digits) < 5:
        await message.reply("Номер телефона неверный. Пожалуйста, отправьте правильный номер:")
        return
    # Save phone
    await state.update_data(phone=phone)
    # Retrieve all collected data
    data = await state.get_data()
    service_id = data.get("service_id")
    service_name = data.get("service_name")
    slot_id = data.get("slot_id")
    client_name = data.get("client_name")
    # Save or update client info in DB
    client_id = None
    existing_client = booking_db.get_client_by_user(PROJECT_ID,message.from_user.id) if hasattr(booking_db, "get_client_by_user") else None
    if existing_client:
        # possibly update info if name/phone changed
        client_id = existing_client[0] if isinstance(existing_client, (tuple, list)) else getattr(existing_client, "id", None)
        booking_db.update_client(PROJECT_ID,client_id, name=client_name, phone=phone) if hasattr(booking_db, "update_client") else booking_db.add_client(PROJECT_ID,message.from_user.id, client_name, phone)
    else:
        client_id = booking_db.add_client(PROJECT_ID,message.from_user.id, client_name, phone)
        # If add_client returns nothing, try to get the client
        if client_id is None:
            new_rec = booking_db.get_client_by_user(PROJECT_ID,message.from_user.id)
            if new_rec:
                client_id = new_rec[0] if isinstance(new_rec, (tuple, list)) else getattr(new_rec, "id", None)
    # Book the slot
    # Book the slot safely
    booking_id = booking_db.create_booking_safe(
        PROJECT_ID,
        message.from_user.id,
        service_id,
        slot_id,
        details=""
    )
    if not booking_id:
        await state.clear()
        await message.answer("К сожалению, выбранное время уже занято. Попробуйте выбрать другое время.")
        return
    # Confirm booking to user
    # Format date/time for user
    slot_info = booking_db.get_slot(PROJECT_ID,slot_id) if hasattr(booking_db, "get_slot") else None
    # Determine date/time from slot_info or stored state data
    booking_date = data.get("date")
    booking_time_str = ""
    if slot_info:
        # assume slot_info contains time or datetime
        slot_dt = None
        if isinstance(slot_info, tuple) or isinstance(slot_info, list):
            slot_dt = slot_info[1]  # if second element is datetime
        else:
            slot_dt = getattr(slot_info, "datetime", None) or getattr(slot_info, "time", None)
        if slot_dt:
            if isinstance(slot_dt, str):
                try:
                    slot_dt_obj = datetime.fromisoformat(slot_dt)
                except:
                    slot_dt_obj = datetime.strptime(slot_dt, "%Y-%m-%d %H:%M")
            elif isinstance(slot_dt, datetime):
                slot_dt_obj = slot_dt
            else:
                # if it's a time object:
                slot_dt_obj = datetime.combine(booking_date, slot_dt)
            booking_date = slot_dt_obj.date()
            booking_time_str = slot_dt_obj.strftime("%H:%M")
    if booking_date and not booking_time_str:
        slot_list = booking_db.get_slots_by_date(PROJECT_ID, booking_date)
        if slot_list:
            for slot in slot_list:
                # для sqlite3.Row читаем по ключу
                sid = slot[0] if isinstance(slot, (tuple, list)) else slot["id"]
                if sid == slot_id:
                    slot_time = slot[1] if isinstance(slot, (tuple, list)) else slot["time"]
                    if slot_time:
                        if isinstance(slot_time, datetime):
                            booking_time_str = slot_time.strftime("%H:%M")
                        elif isinstance(slot_time, str):
                            try:
                                booking_time_str = datetime.fromisoformat(slot_time).strftime("%H:%M")
                            except:
                                booking_time_str = slot_time
                        else:
                            booking_time_str = slot_time.strftime("%H:%M")
                    break
    date_str = booking_date.strftime("%d.%m.%Y") if booking_date else ""
    confirm_text = f"✅ Вы записаны: {service_name or 'услуга'} на {date_str} в {booking_time_str}.\nМы напомним вам за {int(REMINDER_HOURS_BEFORE*60)} мин. до визита."
    await message.answer(confirm_text)
    # Notify admin about new booking (optional, not explicitly asked, but could be helpful)
    try:
        admin_text = (
        f"📅 Новая запись: {client_name} на "
        f"{service_name or 'услуга'} {date_str} {booking_time_str}, тел: {phone}"
        )
        await Bot.get_current().send_message(ADMIN_CHAT, admin_text)
    except Exception as e:
        logging.warning(f"Failed to notify admin about new booking: {e}")
    # Clear user FSM
    await state.clear()
    # Remove the custom keyboard (contact share) by sending a reply to remove it
    try:
        await message.answer("Спасибо! До встречи!", reply_markup=types.ReplyKeyboardRemove())
    except:
        pass

