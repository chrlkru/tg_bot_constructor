# Когда нажали на заголовок или пустую ячейку
@router.callback_query(F.data.startswith(("cal:prev:", "cal:next:")))
async def cal_nav(call: CallbackQuery):
    """
    Обработчик кнопок «〈» и «〉» для обоих режимов:
     - клиент:   cal:prev:YYYY:MM / cal:next:YYYY:MM
     - админ:    cal:prev:<mode>:YYYY:MM / cal:next:<mode>:YYYY:MM
    """
    parts = call.data.split(":")
    action = parts[1]  # "prev" или "next"

    # 1) Определяем, клиент это или админ
    if parts[2] in ("view", "add", "del"):
        # ─── админский формат
        mode = parts[2]
        year = int(parts[3])
        month = int(parts[4])
        project_id = PROJECT_ID
    else:
        # ─── клиентский формат
        mode = "client"
        year = int(parts[2])
        month = int(parts[3])
        project_id = PROJECT_ID

    # 2) Считаем новый месяц/год
    if action == "prev":
        month -= 1
        if month == 0:
            year -= 1
            month = 12
    else:  # "next"
        month += 1
        if month == 13:
            year += 1
            month = 1

    # 3) Рендерим календарь в нужном режиме
    if mode == "client":

        kb = create_calendar(
            project_id=PROJECT_ID,
            mode="client",
            year=year,
            month=month
        )
    else:
        kb = create_calendar(project_id, mode=mode, year=year, month=month)

    # 4) Обновляем только reply_markup, гасим «часики»
    await call.message.edit_reply_markup(reply_markup=kb)
    await call.answer()

