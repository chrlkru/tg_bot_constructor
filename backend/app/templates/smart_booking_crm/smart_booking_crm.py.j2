@router.callback_query(F.data.startswith("cal:date:"))
async def cal_date_selected(
    call: CallbackQuery,
    state: FSMContext
):
    """
    Обработчик нажатия на кнопку с датой в формате cal:date:YYYY-MM-DD.
    """
    await call.answer()  # гасим «часики»

    # 1. Извлекаем дату из callback_data
    _, _, date_str = call.data.split(":", maxsplit=2)
    try:
        chosen = datetime.strptime(date_str, "%Y-%m-%d").date()
    except ValueError:
        # Если вдруг формат неверный
        return await call.message.answer("❗ Неверная дата, попробуйте ещё раз.")

    today = date.today()

    # 2. Если выбрана прошедшая дата — показываем alert и не уходим из календаря
    if chosen < today:
        return await call.answer(
            "Нельзя выбрать прошедшую дату", show_alert=True
        )

    # 3. Иначе — сохраняем дату в FSM и переходим к выбору времени
    await state.update_data(chosen_date=date_str)
    await state.set_state(ClientBooking.choosing_time)

    # 4. Вызываем вашу логику по выбору временных слотов
    #    (например, получаем из БД свободные слоты и строим клавиатуру)
    free_slots = booking_db.get_free_slots_by_date(PROJECT_ID, chosen)
    if not free_slots:
        # Если нет слотов, сообщаем и возвращаемся к выбору даты
        await call.message.edit_text(
            "На эту дату нет свободных мест.\n\nВыберите другую дату:",
            reply_markup=create_calendar(chosen.year, chosen.month)
        )
        # остаёмся в состоянии выбора времени или возвращаем в choosing_date
        await state.set_state(ClientBooking.choosing_date)
        return

    # 5. Строим inline-клавиатуру со свободными временами
    buttons = []
    for slot_id, time_str in free_slots:
        buttons.append(
            [InlineKeyboardButton(
                text=time_str,
                callback_data=f"user:time:{slot_id}"
            )]
        )
    kb = InlineKeyboardMarkup(inline_keyboard=buttons)

    # 6. Редактируем сообщение — вместо календаря выводим список времен
    await call.message.edit_text(
        f"Вы выбрали {chosen.strftime('%d.%m.%Y')}. Выберите время:",
        reply_markup=kb
    )
