    text = "Доступное время:"
    for slot_id, slot_time in free_slots_sorted:
        # slot_time might be datetime or time
        if isinstance(slot_time, str):
    # 1) Попытка ISO-штампа с датой
            try:
                slot_time_obj = datetime.fromisoformat(slot_time)
            except ValueError:
                # 2) Только время "HH:MM"
                t_only = datetime.strptime(slot_time, "%H:%M").time()
                slot_time_obj = datetime.combine(selected_date, t_only)

        elif isinstance(slot_time, datetime):
