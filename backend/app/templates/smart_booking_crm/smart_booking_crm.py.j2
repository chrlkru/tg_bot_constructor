async def admin_add_service_price(message: Message, state: FSMContext):
    text = message.text.replace(",", ".").strip()
    try:
        price = float(text)
    except ValueError:
        return await message.reply("Неправильный формат цены. Введите число, например 750:")
    await state.update_data(price=price)
    await message.answer("Введите длительность в 15-минутных ячейках (напр., 2 = 30 мин):")
    await state.set_state(AdminStates.adding_service_duration)


# 4) Ввод длительности → состояние ‘category’
@router.message(
    F.chat.id == ADMIN_CHAT,
    StateFilter(AdminStates.adding_service_duration)
)
async def admin_add_service_duration(message: Message, state: FSMContext):
    try:
        dur = int(message.text.strip())
        if dur <= 0:
            raise ValueError
    except ValueError:
        return await message.reply("Неверно. Введите целое число ячеек, например 1, 2, 3:")
    await state.update_data(duration_cells=dur)
    await message.answer("Укажите категорию услуги (например, «Маникюр», «Стрижка»):")
    await state.set_state(AdminStates.adding_service_category)


# 5) Ввод категории → финальный вызов в БД и выход в главное меню
@router.message(
    F.chat.id == ADMIN_CHAT,
    StateFilter(AdminStates.adding_service_category)
)
async def admin_add_service_category(message: Message, state: FSMContext):
    category = message.text.strip()
    if not category:
        return await message.reply("Категория не должна быть пустой. Попробуйте ещё раз:")
    data = await state.get_data()
    # едиственный вызов в БД, когда у нас уже есть всё: name, price, duration_cells, category
    service_id = booking_db.add_service(
       PROJECT_ID,
    data["name"],
    data["price"],          # price     – вторым
    data["duration_cells"], # duration  – третьим
    category                # category  – четвёртым
    )
    # подтверждаем и возвращаемся к меню
    await message.answer(
        f"✅ Услуга #{service_id} «{data['name']}» добавлена.",
        reply_markup=build_admin_main_reply_kb()
    )
    await state.clear()
    # 2) Удалить услугу — открыть список для удаления
@router.callback_query(
    F.data == "admin:del_service",
    F.message.chat.id== ADMIN_CHAT
)
async def admin_del_service_cb(call: CallbackQuery, state: FSMContext):
    await call.answer()
    # Получаем клавиатуру с кнопками ❌ Название услуги
    kb = get_delete_service_kb()
    # Редактируем текст и клавиатуру в том же сообщении
    await call.message.edit_text(
        "Выберите услугу для удаления:",
        reply_markup=kb
    )
# 3) Нажали на конкретную кнопку ❌ Название — спросить подтверждение
@router.callback_query(
    F.data.startswith("admin:confirm_del_service:"),
    F.message.chat.id == ADMIN_CHAT
)
async def admin_confirm_del_service(call: CallbackQuery, state: FSMContext):
    await call.answer()
    svc_id = int(call.data.split(":")[-1])
    # Сохраняем во временных данных, чтобы потом знать, что именно удалять
    await state.update_data(del_svc_id=svc_id)
    kb = InlineKeyboardMarkup(
            inline_keyboard=[
                [
                    InlineKeyboardButton(text="✅ Да", callback_data="admin:del_service_yes"),
                    InlineKeyboardButton(text="❌ Нет", callback_data="admin:del_service_no"),
                ]
            ]
        )
    await call.message.edit_text(
        f"Удалить услугу #{svc_id}?",
        reply_markup=kb
    )

# 4) Подтвердили удаление
@router.callback_query(
    F.data == "admin:del_service_yes",
    F.message.chat.id == ADMIN_CHAT
)
async def admin_do_del_service(call: CallbackQuery, state: FSMContext):
    await call.answer()
    data = await state.get_data()
    svc_id = data.get("del_svc_id")
    # Вызываем метод БД
    booking_db.delete_service(PROJECT_ID, svc_id)
    # Показываем обновлённый список услуг
    text, kb = format_services_menu()
    await call.message.edit_text(text, reply_markup=kb)
    await state.clear()

# 5) Отмена удаления
@router.callback_query(
    F.data == "admin:del_service_no",
    F.message.chat.id == ADMIN_CHAT
)
async def admin_cancel_del_service(call: CallbackQuery, state: FSMContext):
    await call.answer("Отмена")
    text, kb = format_services_menu()
    await call.message.edit_text(text, reply_markup=kb)
    await state.clear()

