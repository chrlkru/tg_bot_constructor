# Define FSM states for clients (booking process) and admin (various flows)
class ClientBooking(StatesGroup):
    choosing_service = State()    # user selecting service
    choosing_date = State()       # user selecting date for appointment
    choosing_time = State()       # user selecting specific time slot
    entering_name = State()       # user entering their name
    entering_phone = State()      # user entering or sharing phone number

class AdminStates(StatesGroup):
    # старые
    adding_service           = State()  # ввод названия
    # новые состояния для добавления услуги
    adding_service_price     = State()  # ввод цены
    adding_service_duration  = State()  # ввод длительности (кол-во 15-мин ячеек)
    adding_service_category  = State()  # ввод категории

    adding_interval          = State()
    adding_slot_date         = State()
    adding_slot_time         = State()
    removing_slot_date       = State()
    removing_slot_select     = State()
    viewing_schedule_date    = State()

