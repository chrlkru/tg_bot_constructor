# Helper: create manage services menu keyboard and text
def format_services_menu() -> tuple:
    services = booking_db.get_services(PROJECT_ID)
    text_lines = ["📋 Список услуг:"]
    if services:
        for idx, row in enumerate(services, start=1):
            name      = row["name"]
            # приводим строку к float — тут может понадобится try/except
            try:
                price = float(row["price"])
            except (TypeError, ValueError):
                price = 0.0

            # аналогично с длительностью
            try:
                dur = int(row["duration"])
            except (TypeError, ValueError):
                dur = 0

            cat = row["category"] if "category" in row.keys() else "Общее"

            text_lines.append(
                f"{idx}. {name} — {price:.0f}₽ / {dur}×15 мин ({cat})"
            )

    else:
        text_lines.append("*(нет услуг)*")

    text = "\n".join(text_lines)
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="➕ Добавить услугу", callback_data="admin:add_service"),
         InlineKeyboardButton(text="➖ Удалить услугу", callback_data="admin:del_service")],

    ])
    return text, kb



def get_delete_service_kb() -> InlineKeyboardMarkup:
    services = booking_db.get_services(PROJECT_ID)
    buttons = []
