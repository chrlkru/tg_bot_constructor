# Хендлер для ввода времени (AdminStates.adding_slot_time):

@router.message(
    StateFilter(AdminStates.adding_slot_time),
    F.chat.id == ADMIN_CHAT
)
async def admin_add_slot_time(message: Message, state: FSMContext):
    txt = message.text.strip()
    # 1) Парсим ввод
    try:
        start_str, end_str = [t.strip() for t in txt.split("-")]
        # превращаем в datetime
        slot_date = (await state.get_data())["slot_date"]  # 'YYYY-MM-DD'
        t_start = datetime.fromisoformat(f"{slot_date}T{start_str}")
        t_end   = datetime.fromisoformat(f"{slot_date}T{end_str}")
        if t_end <= t_start:
            raise ValueError("Конец раньше начала")
    except Exception:
        await message.answer("❗ Неверный формат. Используйте HH:MM-HH:MM, и убедитесь, что конец позже начала.")
        return  # остаёмся в том же состоянии

    # 2) Генерируем список 15-минутных времён
    times = []
    cur = t_start
    while cur < t_end:
        times.append(cur.strftime("%H:%M"))
        cur += timedelta(minutes=15)

    # 3) Пробуем вставить каждую ячейку и считаем added/skipped
    added = skipped = 0
    for t in times:
        res = booking_db.add_work_interval(PROJECT_ID, slot_date, t)
        if res is None:
            logging.error(f"Ошибка при add_work_interval для {slot_date} {t}")
            await message.answer("❗ Системная ошибка. Попробуйте позже.")
            await state.clear()
            return
        if res > 0:
            added += 1
        else:
            skipped += 1

    # 4) Выводим итоговое сообщение
    if added > 0:
        await message.answer(
            f"✅ Добавлено новых слотов: {added} из {len(times)} ({slot_date} {start_str}–{end_str}).",
            reply_markup=build_admin_main_reply_kb()
        )
    else:
        # все ячейки уже были
        await message.answer(
            f"⚠️ Новые слоты не добавлены: все {skipped} ячеек уже существуют.",
            reply_markup=build_admin_main_reply_kb()
        )

    await state.clear()

