    buttons.append([InlineKeyboardButton(text="⬅️ Отмена", callback_data="admin:services")])
    return InlineKeyboardMarkup(inline_keyboard=buttons)

# Helper: create schedule view for a given date
def format_schedule_day(sel_date: datetime.date) -> tuple[str, InlineKeyboardMarkup]:
    year, month = sel_date.year, sel_date.month

    # получаем все интервалы-слоты на эту дату
    slots = booking_db.get_slots_by_date(PROJECT_ID, sel_date.isoformat())

    # если слотов нет
    if not slots:
        text = sel_date.strftime("📅 Расписание на %d.%m.%Y:")
        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(
                text="⬅️ Назад",
                callback_data=f"cal:back:view:{year}:{month}"
            )]
        ])
        return text, kb

    text_lines = [f"📅 Расписание на {sel_date.strftime('%d.%m.%Y')}:"]
    buttons    = []

    for slot in slots:
        slot_id   = slot["id"]
        time_str  = slot["time"]            # строка "HH:MM"
        # преобразуем в объект datetime.time
        t_obj     = datetime.strptime(time_str, "%H:%M").time()
        # объединяем с датой для удобного форматирования
        dt_obj    = datetime.combine(sel_date, t_obj)
        t_display = dt_obj.strftime("%H:%M")

        # проверяем, есть ли бронь на этот слот
        booking   = booking_db.get_booking_by_slot(PROJECT_ID, slot_id)
        if booking:
            status_sym  = "❌"
            client_name = booking["client_name"]
            service     = booking["service_name"]
            desc        = f"Занято ({client_name} — {service})"
        else:
            status_sym = "✅"
            desc       = "Свободно"

        # строим вывод
        text_lines.append(f"{t_display} — {desc}")
        buttons.append([
            InlineKeyboardButton(
                text=f"{status_sym} {t_display}",
                callback_data=f"admin:toggle_slot:{slot_id}"
            )
        ])

    # кнопка «Назад» внизу
    buttons.append([
        InlineKeyboardButton(
            text="⬅️ Назад",
            callback_data=f"cal:back:view:{year}:{month}"
        )
    ])

    return "\n".join(text_lines), InlineKeyboardMarkup(inline_keyboard=buttons)
