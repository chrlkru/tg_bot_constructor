@router.callback_query(
    F.data.startswith("slot:del:"),           # только slot:del
    StateFilter(AdminStates.removing_slot_date),
    F.message.chat.id == ADMIN_CHAT
)
async def admin_delete_slot(call: CallbackQuery, state: FSMContext):
    slot_id  = int(call.data.split(":", 2)[2])
    rem_date = (await state.get_data())["rem_date"]

    # берём время, чтобы вызвать delete_work_interval
    slot = booking_db.get_slot(PROJECT_ID, slot_id)
    if not slot:
        await call.answer("Слот не найден", show_alert=True)
        return

    booking_db.delete_work_interval(PROJECT_ID, rem_date, slot["time"])

    # смотрим, остались ли ещё
    slots = booking_db.get_slots_by_date(PROJECT_ID, rem_date)
    if not slots:
        await call.message.edit_text(
            "Все окна удалены. Возвращаю в главное меню.",
            reply_markup=build_admin_main_reply_kb()
        )
        await state.clear()
    else:
        lines   = [f"✅ Окно {slot['time']} удалено.\n",
                   f"🗑️ Оставшиеся окна на {date.fromisoformat(rem_date).strftime('%d.%m.%Y')}:"]
        builder = InlineKeyboardBuilder()
        for iv in slots:
            builder.button(text=f"❌ {iv['time']}", callback_data=f"slot:del:{iv['id']}")
            lines.append(f" • {iv['time']}")
        builder.button(text="⬅️ Отмена", callback_data="admin:menu")
        builder.adjust(1)
        await call.message.edit_text("\n".join(lines), reply_markup=builder.as_markup())

    await call.answer("✅ Окно удалено.")


