@router.message(Command("start"))
async def start_cmd(message: Message, state: FSMContext):
    logging.info("▶ /start received from %s", message.from_user.id)
    # If user is admin
    if message.chat.id == ADMIN_CHAT:
        await state.clear()
        await message.answer(
            "👋 *Админ-панель*\nВыберите действие:",
            reply_markup=build_admin_main_reply_kb(),
            parse_mode="Markdown"
        )
        return
    else:
        # Normal user
        await state.clear()
        # Check if any services exist
        services = booking_db.get_services(PROJECT_ID)
        if not services:
            await message.answer("Извините, сейчас недоступно ни одной услуги для записи. Попробуйте позже.")
            return
        # Set FSM and prompt service selection
        await state.set_state(ClientBooking.choosing_service)
       # Build inline keyboard of services to choose
        kb_buttons = []
        for row in services:
            # если это sqlite3.Row
            if not isinstance(row, (tuple, list)):
                sid, sname = row["id"], row["name"]
            else:
                # если это кортеж/список: id в [0], name в [2]
                sid, sname = row[0], row[2]
            kb_buttons.append([InlineKeyboardButton(text=sname, callback_data=f"user:service:{sid}")])
# --- отправляем пользователю ---
        kb = InlineKeyboardMarkup(inline_keyboard=kb_buttons)
        await message.answer(
            "Здравствуйте! Пожалуйста, выберите услугу:",
            reply_markup=kb
        )
# Handler when a user selects a service (callback from inline buttons)
@router.callback_query(
     F.data.startswith("user:service"),
     StateFilter(ClientBooking.choosing_service)
)
async def user_chosen_service(call: CallbackQuery, state: FSMContext):
    # Example callback data: "user:service:3"
    await call.answer()  # acknowledge callback quickly
    data = call.data.split(":")
    if len(data) < 3:
        return
    service_id = data[2]
    # Fetch service info (like name) if needed
    try:
        service_id = int(service_id)
    except:
        # invalid id
        await state.clear()
        return
    service = booking_db.get_service(PROJECT_ID,service_id) if hasattr(booking_db, "get_service") else None
    service_name = None
    if service:
        # Assuming get_service returns a tuple or object with name
        if isinstance(service, tuple) or isinstance(service, list):
            service_name = service[1] if len(service) > 1 else None
        else:
            service_name = getattr(service, "name", None)
    # Save chosen service in state data
    await state.update_data(service_id=service_id, service_name=service_name)
    # Move to next state for date selection
    await state.set_state(ClientBooking.choosing_date)
    # Show inline calendar for date selection
    await call.message.edit_text(
    "Выберите дату:",
    reply_markup=create_calendar(
        project_id=PROJECT_ID,
        mode="client"
    )
)

# Handler for calendar selection (user choosing date)
@router.callback_query(
    StateFilter(ClientBooking.choosing_date)
)
async def user_chosen_date(call: CallbackQuery, state: FSMContext):
    # Process inline calendar callback
    result, selected_date = user_cal_process(call)  # assuming this returns (bool, date/datetime)
    if not result:
        # If result is False, it means the calendar navigation (next/prev month) occurred, we should update the calendar
        # The inline_calendar.process_selection likely handles updating internally or returns new calendar markup
        # Let's assume it might return new markup to set
        new_cal = None
        try:
            new_cal = get_current_calendar()  # fictional function to get updated keyboard
        except:
            new_cal = create_calendar()  # fallback to a fresh calendar if specific method not available
        if new_cal:
            await call.message.edit_reply_markup(new_cal)
        await call.answer()
        return
    # If a date is selected
    await call.answer()  # dismiss loading
    if isinstance(selected_date, datetime):
        # If a full datetime is returned (maybe with default time=00:00)
        selected_date = selected_date.date()
    # Save chosen date
    await state.update_data(date=selected_date)
    # Retrieve available time slots for that date
    free_slots = booking_db.get_free_slots_by_date(PROJECT_ID,selected_date) if hasattr(booking_db, "get_free_slots_by_date") else None
    if free_slots is None:
        # If no specific function, get all slots and filter by status free
        all_slots = booking_db.get_slots_by_date(PROJECT_ID,selected_date)
        free_slots = []
        if all_slots:
            for slot in all_slots:
                # Determine status from slot record similar to earlier
                status = None
                slot_id = None
                slot_time = None
                if isinstance(slot, tuple) or isinstance(slot, list):
                    slot_id = slot[0]; slot_time = slot[1]; status = slot[2] if len(slot) > 2 else "free"
                    if isinstance(slot_time, str) and len(slot_time)==5 and slot_time[2]==":":
                        slot_time = datetime.strptime(slot_time, "%H:%M").time()
                else:
                    slot_id = slot.id; slot_time = slot.time; status = slot.status
                if status == "free":
                    free_slots.append((slot_id, slot_time))
    # If still None or empty, means no free slots on that date
    if not free_slots:
        await call.answer("На эту дату нет свободных времён.", show_alert=True)
