#!/usr/bin/env python3
"""
helper_bot.py
Полный модуль Telegram-бота на Aiogram 3 для управления «пастами».

Функции
▪️ /adminhelp   – инлайн-меню в чате ADMIN_CHAT (добавить / изменить / удалить / список)
▪️ /alias       – выдаёт текст/файл пасты (или «Недостаточно прав», если admin_only)
▪️ /help        – краткая справка
▪️ /cancel      – отменить текущий FSM-диалог
Логи вызовов пишутся в таблицу logs.

Требует внешних модулей:
  utils/helper_db.py – CRUD-функции с таблицей helper_entries + safe_execute()
  utils/media.py     – save_media_file(PROJECT_ID, bytes, filename, media_root)

Запуск (во внешнем run.py):
    from helper_bot import bot, dp, register_bot_commands
    import asyncio
    asyncio.run(register_bot_commands())
    dp.start_polling(bot)
"""

import datetime
import os
from pathlib import Path

from aiogram import Bot, Dispatcher, F, types
from aiogram.client.default import DefaultBotProperties
from aiogram.enums import ChatMemberStatus, ParseMode
from aiogram.filters import Command
from aiogram.fsm.context import FSMContext
from aiogram.fsm.storage.memory import MemoryStorage
from aiogram.fsm.state import State, StatesGroup
from aiogram.types import (
    BotCommand, BotCommandScopeDefault, CallbackQuery,
    InlineKeyboardButton, InlineKeyboardMarkup, InputFile, Message
)
from dotenv import load_dotenv

from utils.helper_db import (
    safe_execute, add_helper_entry, get_helper_by_alias,
    get_all_helper_entries, update_helper_entry, delete_helper_entry
)
from utils.media import save_media_file

# ──────────────────────────────────── Конфигурация ───────────────────────────
load_dotenv()
BOT_TOKEN   = os.getenv("TOKEN") or exit("TOKEN not set in .env")
PROJECT_ID = {{ project_id }}        # ID проекта (для разделения данных FAQ в БД)
ADMIN_CHAT = {{ admin_chat_id }}     # ID чата администратора (или группы)

MEDIA_ROOT = Path(__file__).parent.parent / "media" / str(PROJECT_ID)
MEDIA_ROOT.mkdir(parents=True, exist_ok=True)

bot = Bot(token=BOT_TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
dp  = Dispatcher(storage=MemoryStorage())

# ───────────────────────────── Таблица логов, если нет ───────────────────────
safe_execute("""
CREATE TABLE IF NOT EXISTS logs (
    id        INTEGER PRIMARY KEY AUTOINCREMENT,
    project_id INTEGER,
    user_id   INTEGER,
    username  TEXT,
    chat_id   INTEGER,
    used_at   TEXT,
    alias     TEXT
)
""")

# ──────────────────────────────── FSM-состояния ──────────────────────────────
class AdminFSM(StatesGroup):
    # главное меню
    in_menu = State()
    # добавление
    add_alias  = State()
    add_text   = State()
    add_media  = State()
    add_admin  = State()
    # редактирование
    edit_choose  = State()
    edit_field   = State()
    edit_value   = State()
    edit_admin   = State()
    # удаление
    del_choose  = State()
    del_confirm = State()

# ─────────────────────────────── Вспомогательные ─────────────────────────────
def kb_admin_menu() -> InlineKeyboardMarkup:
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton("➕ Новая паста", callback_data="add")],
        [InlineKeyboardButton("✏️ Изменить",   callback_data="edit")],
        [InlineKeyboardButton("🗑 Удалить",    callback_data="delete")],
        [InlineKeyboardButton("📄 Список",     callback_data="list")],
    ])

async def is_admin_chat(chat_id: int) -> bool:
    return chat_id == ADMIN_CHAT

async def register_bot_commands() -> None:
    """Отобразить публичные alias + базовые команды в / меню Telegram."""
    cmds = [
        BotCommand("help",   "Помощь"),
        BotCommand("cancel", "Отменить действие"),
    ]
    public = get_all_helper_entries(PROJECT_ID, is_admin=False)
    cmds.extend(BotCommand(e["alias"], "") for e in public)
    await bot.set_my_commands(cmds, scope=BotCommandScopeDefault())

def detect_parse_mode(text: str) -> str | None:
    if "<" in text and ">" in text:
        return "HTML"
    # простая эвристика на Markdown-символы
    if any(sym in text for sym in ("*", "_", "`", "~")):
        return "Markdown"
    return None

# ─────────────────────────────── Базовые команды ─────────────────────────────
@dp.message(Command("help"))
async def cmd_help(msg: Message):
    await msg.answer(
        "📌 <b>Команды</b>\n"
        "/adminhelp – меню управления пастами (только в админ-чате)\n"
        "/cancel    – отменить текущее действие\n\n"
        "Для получения пасты отправьте «/alias»."
    )

@dp.message(Command("cancel"))
async def cmd_cancel(msg: Message, state: FSMContext):
    if await state.get_state() is None:
        return await msg.answer("Нет активного действия.")
    await state.clear()
    await msg.answer("❌ Действие отменено.")

# ─────────────────────────────── Админ-меню ──────────────────────────────────
@dp.message(Command("adminhelp"))
async def cmd_adminhelp(msg: Message, state: FSMContext):
    if not await is_admin_chat(msg.chat.id):
        return  # молча игнорируем
    await state.set_state(AdminFSM.in_menu)
    await msg.answer("🛠 <b>Меню управления пастами</b>", reply_markup=kb_admin_menu())

# ─────────────────────────────── Добавление пасты ────────────────────────────
@dp.callback_query(lambda c: c.data == "add", AdminFSM.in_menu)
async def cb_add_start(cb: CallbackQuery, state: FSMContext):
    await cb.message.edit_text("Введите alias (без «/»):")
    await state.set_state(AdminFSM.add_alias)
    await cb.answer()

@dp.message(AdminFSM.add_alias)
async def add_alias(msg: Message, state: FSMContext):
    alias = msg.text.strip().lstrip("/").lower()
    if not alias.isascii() or " " in alias:
        return await msg.answer("❗️ Допустимы латинские символы без пробелов.")
    if get_helper_by_alias(PROJECT_ID, alias, is_admin=True):
        return await msg.answer("❗️ Такой alias уже есть.")
    await state.update_data(alias=alias)
    await msg.answer("Введите текст пасты (HTML/Markdown):")
    await state.set_state(AdminFSM.add_text)

@dp.message(AdminFSM.add_text)
async def add_text(msg: Message, state: FSMContext):
    await state.update_data(content=msg.text)
    await msg.answer("Прикрепите фото/документ или отправьте «нет»:")
    await state.set_state(AdminFSM.add_media)

@dp.message(AdminFSM.add_media, F.content_type.in_({"photo", "document", "text"}))
async def add_media(msg: Message, state: FSMContext):
    media_path = ""
    if msg.photo or msg.document:
        file = msg.photo[-1] if msg.photo else msg.document
        file_name = file.file_id + (".jpg" if msg.photo else f".{Path(file.file_name).suffix.lstrip('.') or 'bin'}")
        bts = await bot.download_file((await bot.get_file(file.file_id)).file_path)
        media_path = save_media_file(PROJECT_ID, bts, file_name, MEDIA_ROOT).name
    elif msg.text.lower() != "нет":
        return await msg.answer("Ожидался файл или «нет».")
    await state.update_data(media=media_path)
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton("Только админам", callback_data="only_yes"),
         InlineKeyboardButton("Всем",           callback_data="only_no")]
    ])
    await msg.answer("Доступность пасты:", reply_markup=kb)
    await state.set_state(AdminFSM.add_admin)

@dp.callback_query(lambda c: c.data in ("only_yes", "only_no"), AdminFSM.add_admin)
async def add_finish(cb: CallbackQuery, state: FSMContext):
    data = await state.get_data()
    admin_only = cb.data == "only_yes"
    add_helper_entry(PROJECT_ID, data["alias"], data["content"], data["media"], admin_only)
    await state.clear()
    await register_bot_commands()
    await cb.message.edit_text(f"✅ Паста /{data['alias']} сохранена.", reply_markup=kb_admin_menu())
    await cb.answer()

# ─────────────────────────────── Список паст ────────────────────────────────
@dp.callback_query(lambda c: c.data == "list", AdminFSM.in_menu)
async def cb_list(cb: CallbackQuery):
    entries = get_all_helper_entries(PROJECT_ID, is_admin=True)
    if not entries:
        await cb.message.edit_text("Список пуст.", reply_markup=kb_admin_menu())
        return await cb.answer()
    lines = []
    for e in entries:
        lock = "🔒" if e["admin_only"] else "🔓"
        lines.append(f"{lock} /{e['alias']} — {e['content'][:40]}…")
    await cb.message.edit_text("\n".join(lines), reply_markup=kb_admin_menu())
    await cb.answer()

# ─────────────────────────────── Удаление пасты ─────────────────────────────
@dp.callback_query(lambda c: c.data == "delete", AdminFSM.in_menu)
async def cb_del_list(cb: CallbackQuery, state: FSMContext):
    ent = get_all_helper_entries(PROJECT_ID, is_admin=True)
    if not ent:
        await cb.answer("Список пуст.")
        return
    kb = InlineKeyboardMarkup(row_width=1)
    for e in ent:
        kb.add(InlineKeyboardButton(f"🗑 /{e['alias']}", callback_data=f"d_{e['id']}"))
    kb.add(InlineKeyboardButton("↩️ Назад", callback_data="back_menu"))
    await cb.message.edit_text("Выберите пасту для удаления:", reply_markup=kb)
    await state.set_state(AdminFSM.del_choose)
    await cb.answer()

@dp.callback_query(lambda c: c.data.startswith("d_"), AdminFSM.del_choose)
async def cb_del_confirm(cb: CallbackQuery, state: FSMContext):
    eid = int(cb.data.split("_")[1])
    await state.update_data(del_id=eid)
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton("✅ Удалить", callback_data="yes_del"),
         InlineKeyboardButton("❌ Отмена",  callback_data="no_del")]
    ])
    await cb.message.edit_text("Удалить выбранную пасту?", reply_markup=kb)
    await state.set_state(AdminFSM.del_confirm)
    await cb.answer()

@dp.callback_query(lambda c: c.data in ("yes_del", "no_del"), AdminFSM.del_confirm)
async def cb_del_execute(cb: CallbackQuery, state: FSMContext):
    if cb.data == "yes_del":
        delete_helper_entry(PROJECT_ID, (await state.get_data())["del_id"])
        await register_bot_commands()
        text = "✅ Паста удалена."
    else:
        text = "❌ Отменено."
    await state.clear()
    await cb.message.edit_text(text, reply_markup=kb_admin_menu())
    await cb.answer()

# ─────────────────────────────── Редактирование ─────────────────────────────
@dp.callback_query(lambda c: c.data == "edit", AdminFSM.in_menu)
async def cb_edit_pick(cb: CallbackQuery, state: FSMContext):
    ent = get_all_helper_entries(PROJECT_ID, is_admin=True)
    if not ent:
        await cb.answer("Список пуст.")
        return
    kb = InlineKeyboardMarkup(row_width=1)
    for e in ent:
        kb.add(InlineKeyboardButton(f"✏️ /{e['alias']}", callback_data=f"e_{e['id']}"))
    kb.add(InlineKeyboardButton("↩️ Назад", callback_data="back_menu"))
    await cb.message.edit_text("Выберите пасту для изменения:", reply_markup=kb)
    await state.set_state(AdminFSM.edit_choose)
    await cb.answer()

@dp.callback_query(lambda c: c.data.startswith("e_"), AdminFSM.edit_choose)
async def cb_edit_field(cb: CallbackQuery, state: FSMContext):
    eid = int(cb.data.split("_")[1])
    await state.update_data(eid=eid)
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton("Alias",  callback_data="f_alias")],
        [InlineKeyboardButton("Текст",  callback_data="f_text")],
        [InlineKeyboardButton("Медиа",  callback_data="f_media")],
        [InlineKeyboardButton("↩️ Назад", callback_data="back_menu")]
    ])
    await cb.message.edit_text("Что изменить?", reply_markup=kb)
    await state.set_state(AdminFSM.edit_field)
    await cb.answer()

@dp.callback_query(lambda c: c.data.startswith("f_"), AdminFSM.edit_field)
async def cb_edit_value_prompt(cb: CallbackQuery, state: FSMContext):
    field = cb.data.split("_")[1]
    await state.update_data(field=field)
    prompt = {
        "alias": "Введите новый alias:",
        "text":  "Введите новый текст:",
        "media": "Прикрепите новый файл или «нет»:"
    }[field]
    await cb.message.edit_text(prompt)
    await state.set_state(AdminFSM.edit_value)
    await cb.answer()

@dp.message(AdminFSM.edit_value, F.content_type.in_({"text", "photo", "document"}))
async def edit_value(msg: Message, state: FSMContext):
    data = await state.get_data()
    eid   = data["eid"]
    field = data["field"]
    if field == "alias":
        update_helper_entry(PROJECT_ID, eid, alias=msg.text.strip().lstrip("/"))
    elif field == "text":
        update_helper_entry(PROJECT_ID, eid, content=msg.text)
    else:  # media
        if msg.text and msg.text.lower() == "нет":
            update_helper_entry(PROJECT_ID, eid, media_path="")
        elif msg.photo or msg.document:
            file = msg.photo[-1] if msg.photo else msg.document
            fname = file.file_id + (".jpg" if msg.photo else Path(file.file_name).suffix or ".bin")
            bts = await bot.download_file((await bot.get_file(file.file_id)).file_path)
            mname = save_media_file(PROJECT_ID, bts, fname, MEDIA_ROOT).name
            update_helper_entry(PROJECT_ID, eid, media_path=mname)
        else:
            return await msg.answer("Ожидался файл или «нет».")
    await register_bot_commands()
    await msg.answer("✅ Обновлено.", reply_markup=kb_admin_menu())
    await state.clear()

# ─────────────────────────────── Возврат в меню ─────────────────────────────
@dp.callback_query(lambda c: c.data == "back_menu", AdminFSM.in_menu | AdminFSM.edit_field |
                   AdminFSM.edit_choose | AdminFSM.del_choose | AdminFSM.del_confirm)
async def cb_back_menu(cb: CallbackQuery, state: FSMContext):
    await state.clear()
    await cb.message.edit_text("🛠 Меню управления пастами", reply_markup=kb_admin_menu())
    await cb.answer()

# ─────────────────────────────── Выдача пасты /alias ─────────────────────────
@dp.message(F.text.startswith("/"))
async def cmd_alias(msg: Message):
    text = msg.text.split()[0].lstrip("/")
    if text in ("adminhelp", "cancel", "help"):
        return
    is_admin_chat = await is_admin_chat(msg.chat.id)
    row = get_helper_by_alias(PROJECT_ID, text, is_admin=is_admin_chat)
    if not row:
        return
    content, media = row
    # Логирование
    safe_execute(
        "INSERT INTO logs(project_id, user_id, username, chat_id, used_at, alias) VALUES (?, ?, ?, ?, ?, ?)",
        (PROJECT_ID, msg.from_user.id, msg.from_user.username or "",
         msg.chat.id, datetime.datetime.utcnow().isoformat(), text)
    )
    if media:
        path = MEDIA_ROOT / media
        if not path.exists():
            await msg.answer(content or " ")
        elif path.suffix.lower() in (".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp"):
            await bot.send_photo(msg.chat.id, InputFile(path), caption=content or "")
        else:
            await bot.send_document(msg.chat.id, InputFile(path), caption=content or "")
    else:
        await msg.answer(content or " ")
